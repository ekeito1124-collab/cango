# Vercel Dashboard（Storage → Neon）から `vercel env pull .env.local` で取得する
cango_DATABASE_URL="postgresql://..."
cango_DATABASE_URL_UNPOOLED="postgresql://..."

# セッション署名用の秘密鍵（本番では必須）。例: openssl rand -base64 32
AUTH_SECRET=""

# 任意：自動翻訳と AI キャラクター機能（未設定ならシード済みの訳のみ表示し、AI 機能は非表示）
ANTHROPIC_API_KEY=""

# 任意：メール送信（Resend）。未設定ならサーバーログに出力のみ
RESEND_API_KEY=""
MAIL_FROM=""

# 任意：メール内リンクのベース URL（未設定ならリクエストのホストから生成）
APP_URL=""

# シード時の管理者・デモ事業者のパスワード
SEED_PASSWORD="demo-pass-1234"
